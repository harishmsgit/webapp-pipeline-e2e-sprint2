# Example Terraform variables file.
# Copy this to terraform.tfvars and update values for your AWS account and environment.

aws_region           = "ap-south-1"          # AWS region used for all resources.
aws_account_id       = "451620995756"        # AWS account ID for resource naming and permissions.
tf_state_bucket      = "webapp-pipeline-terraform-state" # S3 bucket for remote Terraform state.
tf_state_lock_table  = "webapp-pipeline-terraform-lock"   # DynamoDB table for state locking.
tf_state_key         = "global/sprint2/terraform.tfstate" # S3 object key for remote state.
cluster_name         = "webapp-pipeline-sprint2-cluster"  # Base name for EKS and related resources.
vpc_cidr             = "10.0.0.0/16"                   # VPC CIDR block.
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]  # Public subnet CIDR blocks.
instance_type        = "t3.micro"                       # EC2 instance type for bastion/support host.
node_group_desired_capacity = 2                            # Desired count of EKS worker nodes.
node_group_min_size  = 1                                  # Minimum count of EKS worker nodes.
node_group_max_size  = 3                                  # Maximum count of EKS worker nodes.
